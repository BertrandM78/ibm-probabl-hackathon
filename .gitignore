# secrets and skore-cli credentials
.env
.skore

# virtual environment created in the install steps
.venv/

# skore skills are installed per machine — do not vendor them
.bob/*
# ...but the workspace rules, agents, hooks and project skills do ship with the repo
!.bob/rules/
!.bob/agents/
!.bob/hooks/
!.bob/skills/
.bob/skills/*
!.bob/skills/brainstorm/
!.bob/skills/cv/
!.bob/skills/idea/
!.bob/skills/review/
!.bob/skills/status/
!.bob/skills/submit/
!.bob/skills/submit-prep/

# per-machine agent symlinks pointing into .bob/skills
.pi/
.agents/

# agent scratch probes
scratch/

# Kaggle submission files (regenerated by lab/submit.py;
# the leaderboard and lab/LOG.md, not git, are the record)
submissions/

# bytecode
__pycache__/
*.pyc

# nested clone of https://github.com/probabl-ai/skills-hackathon
/skills/

# OS / IDE
.DS_Store

# local git worktrees
.worktrees/

# lab: regenerable outputs and throwaway scripts (results.csv, folds.csv, LOG.md stay tracked)
lab/runs/
lab/scratch/
